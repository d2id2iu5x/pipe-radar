{
  "name": "pipe-radar",
  "version": "2.4.0",
  "private": true,
  "type": "module",
  "engines": { "node": "22.x" },
  "scripts": {
    "build": "node --import tsx scripts/build-site.ts",
    "scan": "node --import tsx scripts/scan-jobs.ts",
    "seed": "node --import tsx scripts/seed-static-data.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "acceptance": "vitest run tests/integration/acceptance.test.ts"
  },
  "dependencies": {
    "@netlify/blobs": "^11.1.0",
    "@netlify/functions": "^6.0.0",
    "cheerio": "^1.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "jsdom": "^30.1.1",
    "typescript": "^7.0.2",
    "tsx": "^4.20.6",
    "vitest": "^5.0.1"
  }
}
